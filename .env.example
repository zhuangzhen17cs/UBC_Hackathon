# Copy to .env.local. The agent test runs without a key (every agent HOLDs).
# Set XAI_API_KEY to get live decisions.
# .env.local is gitignored. Never commit secret keys.

# ---- Price ----
# fallback = poll FALLBACK_PRICE_URL (works on localhost with no tunnel)
# quicknode = use prices POSTed to /api/quicknode; fall back if the stream goes quiet
PRICE_SOURCE=fallback

# Public SOL/USD. No key. Coinbase is the primary; CoinGecko is the backup.
# Pyth Hermes returned 401 without a key, and Binance is geo-blocked, so neither is the default.
FALLBACK_PRICE_URL=https://api.coinbase.com/v2/prices/SOL-USD/spot
FALLBACK_PRICE_URL_BACKUP=https://api.coingecko.com/api/v3/simple/price?ids=solana&vs_currencies=usd
# How long a QuickNode price stays fresh before the public feed fills in. Milliseconds.
QUICKNODE_MAX_AGE_MS=30000

# QuickNode Stream destination (set in the QuickNode dashboard, not here):
#   https://<tunnel-host>/api/quicknode
# The route rejects requests whose secret does not match.
QUICKNODE_WEBHOOK_SECRET=
# Optional. Devnet RPC used to send memos and payouts. Public devnet RPC is the default.
QUICKNODE_DEVNET_RPC_URL=
# Optional. Only used if we later create the Stream from a script.
QUICKNODE_API_KEY=

# ---- Solana devnet ----
SOLANA_NETWORK=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_SOLANA_NETWORK=devnet
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com

# Filled by scripts/setup-devnet.ts. Addresses are public. Secret keys are not.
USDC_MINT=
USDC_DECIMALS=6
NEXT_PUBLIC_USDC_MINT=
ESCROW_PUBLIC_KEY=
NEXT_PUBLIC_ESCROW_PUBLIC_KEY=

# Base58 secret keys. Server only.
ESCROW_SECRET_KEY=
AGENT_DEGEN_SECRET_KEY=
AGENT_GRANDMA_SECRET_KEY=
AGENT_CONTRARIAN_SECRET_KEY=
AGENT_GROK_SECRET_KEY=

# Filled by npm run setup:devnet. Import the spectator secret into Phantom on Devnet.
# The script prints the public address and writes the secret only to .env.local.
DEMO_SPECTATOR_PUBLIC_KEY=
DEMO_SPECTATOR_SECRET_KEY=

# ---- Model keys. Each agent picks one. The server holds the key, not the browser. ----
# Grok is also the commentator. Gemini, ChatGPT, and Claude are optional until an agent uses them.
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-4.7
# Per-decision timeout. A miss becomes PASS.
XAI_TIMEOUT_MS=25000

GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Legacy switch. Agents now call their own provider. Leave this on xai.
# openai | anthropic | groq | xai
LLM_PROVIDER=xai
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# ---- ElevenLabs ----
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
ELEVENLABS_VOICE_COMMENTATOR=
ELEVENLABS_VOICE_DEGEN=
ELEVENLABS_VOICE_GRANDMA=
ELEVENLABS_VOICE_CONTRARIAN=
ELEVENLABS_VOICE_GROK=

# ---- Round clock (milliseconds) ----
BETTING_MS=120000
BATTLE_MS=480000
TICK_MS=15000
DEMO_MODE=false
DEMO_BETTING_MS=20000
DEMO_BATTLE_MS=160000
DEMO_TICK_MS=8000
